  <DUT Name="ty_Cylinder_5_3_Inputs" Id="{9ced1aa3-5c62-4c3d-9cd7-1b4bdd3f231c}">
    <Declaration><![CDATA[TYPE ty_Cylinder_5_3_Inputs :
STRUCT
    bTestMode                    : BOOL;
    bManualMode                  : BOOL;
    
    // Command (Auto)
    b_Reqest_CylinderOut         : BOOL; 
    b_Reqest_CylinderIn          : BOOL; 
    
    // HMI (Manual)
    bHmi_Manual_Reqest_Out       : BOOL; 
    bHmi_Manual_Reqest_In        : BOOL; 
    
    // Physical Feedback Sensors
    bS_Feedback_Sensor_IsOut     : BOOL;
    bS_Feedback_Sensor_IsIn      : BOOL;
    
    // Settings (префикс t_ для типа TIME)
    t_FeedbackSensorDelay        : TIME := T#300MS; 
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>